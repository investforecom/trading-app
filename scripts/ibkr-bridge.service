[Unit]
Description=IBKR Bridge – Claude MCP relay for trading-app refresh button
After=network.target

[Service]
Type=simple
User=char
WorkingDirectory=/home/char/workspace
ExecStart=/usr/bin/python3 /home/char/workspace/trading-app/scripts/ibkr_bridge.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
