# Copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml and loader/sync.sh.

# Public IP of the OVH box — used as Metabase's site URL until a domain is registered.
# When you have a domain: add it here as DOMAIN=, uncomment Caddy in docker-compose.yml,
# and replace the metabase port binding with the caddy service.
SERVER_IP=

# Single Postgres user for the whole stack.
# Loader writes to 'trading' DB. Metabase app state lives in 'metabase' DB.
POSTGRES_USER=trading
POSTGRES_PASSWORD=

# Metabase — connect to its own app-state DB, then add 'trading' as a data source via UI
METABASE_DB_TYPE=postgres
METABASE_DB_HOST=postgres
METABASE_DB_PORT=5432
METABASE_DB_DBNAME=metabase
METABASE_DB_USER=trading
METABASE_DB_PASS=           # same as POSTGRES_PASSWORD
